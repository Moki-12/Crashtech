#include <stdlib.h>
#include <stdio.h>
#include <string.h>

typedef struct chainon {
    int age;
    int tab[3][3];
    struct chainon *suivant;
} age_data;

typedef struct liste {
    age_data *tete;
} list_age;


age_data *creation(int a){
age_data *nv = malloc(sizeof(age_data));
if(nv == NULL){
exit(1);
}
nv->age = a;
nv->suivant = NULL;
for (int i=0; i<3; i++){
    for (int j=0; j<3; j++){
        nv->tab[i][j] = 0;
    }
}
return nv;
}

void remplir_chainon (age_data *a, int g, int t){
    if (a == NULL){
        exit(4);
    }
        int indice_g;
    if (g == 1) indice_g = 0;
    else if (g == 2) indice_g = 1;
        else indice_g = 2;
        int indice_t = t-1;
        if (indice_t >= 0 && indice_t < 3 && indice_g >= 0 && indice_g < 3){
        a->tab[indice_t][indice_g]++;
        }
}

void ajouter (list_age *l, age_data *a){
    if (l == NULL || a == NULL){
        exit(5);
    }
    a->suivant = l->tete;
    l->tete = a;
}

age_data *verif_exist (list_age *l, int age){
    if(l == NULL){
        exit(3);
    }
    age_data *p = l->tete;
    age_data *prece = NULL;
    while(p != NULL && p->age < age){
        prece = p;
        p = p->suivant;
    }
    if(p!= NULL && p->age == age){
        return p;
    }
    age_data *nv = creation(age);
    nv->suivant = p;
    if(prece == NULL){
        l->tete = nv;
    }
    else{
        prece->suivant = nv;
    }
    return nv;
}

void libere_liste(list_age *l){
    if (l == NULL){
        exit(1);
    }
    age_data *p = l->tete;
    age_data *suivant = NULL;

    while(p!= NULL){
        suivant = p->suivant;
        free(p);
        p = suivant;
    }
}

void lire_ficher (FILE *f, char *nom_fichier, list_age *l){
    /*if (f == NULL || a_d == NULL || nom_fichier == NULL){
        exit(2);
    }*/
    int age;
    int année;
    int naissance;
    int gender;
    int types;
    char ligne [200];
    f = fopen (nom_fichier, "r");
    if (f == NULL){
    perror("Erreur ouverture fichier");
    return;
    }
    if ((fgets (ligne, 199, f)) == NULL){
    fclose(f);
    return;
    }
    while ((fgetc(f)) != EOF){
        fseek (f, -1, SEEK_CUR);
        fscanf (f, "%d;%*d;%*d;%*d;%d;%*d;%d;%d", &année, &types, &gender, &naissance);
        age = année - naissance;
        if (age >= 0 && age < 120){
        age_data *a_d = verif_exist(l, age);
        remplir_chainon(a_d, gender, types);
        }
        fgets (ligne, 199, f);
    }
    fclose(f);
}

float calcul_pct (int valeur, int total){
    if (total == 0){
        return 0.0f;
    }
    return ((float)valeur/total)*100;
}

int calcul_total_filtre (age_data *a, int filtre_type, int filtre_genre){
    if (a == NULL){
        return 0;
    }
    int total = 0;
    for (int i=0; i<3; i++){
        for (int j=0; j<3; j++){
            if ((filtre_type == 0 || filtre_type == i+1) && (filtre_genre == 0 || filtre_genre == j+1)){
                total += a->tab[i][j];
            }
        }
    }
    return total;
}

char *nom_type(int t){
    switch(t){
        case 1: return "Conducteurs";
        case 2 : return "Passagers";
        case 3:  return "Piétons";
        default: return "Tous les types"; /*cy_crash_tech_small_sorted.csv*/
    }
}

char *nom_genre(int s){
    switch (s){
        case 1: return "Hommes";
        case 2: return "Femmes";
        case 3: return "pas de genre";
        default: return "Tous les genres";
    }
}

void affichage (list_age *l, int filtre_type, int filtre_genre){
    /*if (l == NULL){
        exit(7);
    }*/
    printf("======================================================\n");
    printf("PYRAMIDE DES AGES - %s - %s\n", nom_genre(filtre_genre), nom_type(filtre_type));
    printf("======================================================\n\n");
    printf("(1# = 0.25 %%)\n");
    age_data *courant = l->tete;
    while (courant != NULL){
        int total_tous = calcul_total_filtre(courant, 0, 0);
        int nb = calcul_total_filtre(courant, filtre_type, filtre_genre);
        float pct = calcul_pct(nb, total_tous);
        int bloc = (int)(pct * 4);
        if (bloc > 40){
            bloc = 40;
        }
        printf("%3d ans : %8d  %5.2f %%", courant->age, nb, pct);
        for (int i = 0; i < bloc; i++){
            printf("#");
        }
        printf("\n");
        courant = courant->suivant;
    }
}


